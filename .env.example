# Copie este archivo como .env para probar en su computadora. En Render se configura en Environment.
# Opcional: activa la ayuda con IA (https://platform.claude.com)
ANTHROPIC_API_KEY=
IA_LIMITE_POR_HORA=15
IA_LIMITE_DIARIO=300
# Peticiones por minuto por persona (protección contra abuso)
LIMITE_PETICIONES_MINUTO=240
# Otros dominios que pueden llamar a la API (separados por coma). Vacío = solo la propia página.
ORIGENES_PERMITIDOS=
